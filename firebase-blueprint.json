{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Sneaker or streetwear accessory item",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "brand": { "type": "string", "maxLength": 60 },
        "category": { "type": "string", "maxLength": 50 },
        "gender": { "type": "string", "enum": ["Men", "Women", "Unisex"] },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "images": { "type": "array" },
        "sizes": { "type": "object" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "isHyped": { "type": "boolean" },
        "isClearance": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 2000 }
      },
      "required": ["name", "brand", "category", "price", "images"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 200 },
        "customerName": { "type": "string", "maxLength": 150 },
        "items": { "type": "array" },
        "shippingAddress": { "type": "object" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Pending", "Failed", "COD"] },
        "orderStatus": { "type": "string", "enum": ["Processing", "Shipped", "Delivered", "Cancelled"] },
        "totalAmount": { "type": "number" },
        "codFee": { "type": "number" },
        "trackingLink": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "items", "shippingAddress", "paymentMethod", "paymentStatus", "orderStatus", "totalAmount"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product review",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "userAvatar": { "type": "string", "maxLength": 500 },
        "rating": { "type": "number" },
        "title": { "type": "string", "maxLength": 150 },
        "comment": { "type": "string", "maxLength": 2000 },
        "photos": { "type": "array" },
        "verifiedPurchase": { "type": "boolean" },
        "isHidden": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["productId", "userId", "userName", "rating", "comment"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin access whitelist record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "addedAt": { "type": "string" },
        "addedBy": { "type": "string", "maxLength": 200 }
      },
      "required": ["email"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Newsletter subscriber email",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "subscribedAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global store checkout and payment configuration",
      "type": "object",
      "properties": {
        "defaultPaymentMethod": { "type": "string", "maxLength": 50 },
        "codFee": { "type": "number" },
        "paymentMethodsEnabled": { "type": "object" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of sneakers and accessories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer sneaker reviews"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized admin users"
    },
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Newsletter subscribers"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Store configuration document"
    },
    "/users/{userId}/wishlist/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "User specific wishlist items"
    }
  }
}
