rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'haarahad3747@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)))
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection health check
    match /test/{testId} {
      allow read: if true;
    }

    // Products collection: public read, admin write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Reviews collection: public read (if not hidden), author can create/edit/delete, admin can moderate
    match /reviews/{reviewId} {
      allow read: if resource.data.isHidden != true || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Orders collection: user reads their own orders, admins read all
    match /orders/{orderId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if true; // allow placing orders (signed-in or guest)
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // User wishlist
    match /users/{userId}/wishlist/{productId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Admins collection: only admins can manage
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Newsletter subscribers
    match /subscribers/{subscriberId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.email is string;
      allow delete: if isAdmin();
    }

    // Store settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
